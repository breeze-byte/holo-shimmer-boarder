// holo-border override of Hyprland v0.56.2's src/render/shaders/glsl/gradient.glsl.
// GENERATED by gen-holo-border.py from lib/shaders/gradient.glsl.in; loaded with
// "hyprctl reloadshaders <dir>". Identical to the original, except a gradient with at least
// HOLO_MIN_STOPS colors (the holo border) is treated as a loop and repeated HOLO_REPEAT times,
// so it gets more, shorter bands than Hyprland's 10-color limit allows. Every other gradient
// (inactive border, other plugins) renders exactly as before.
//
// Switch sweep: when the 10th stop is a control stop (black, i.e. OkLab L = 0) only the first 9
// are colors, and the control stop's alpha is the sweep position (0 = no sweep, 1..255 = start..end).
// The sweep is one half-opacity white bar that runs along one edge of the border (the top or the
// bottom), from the left corner to the right one, fading out at the end.
#define HOLO_REPEAT @REPEAT@
#define HOLO_MIN_STOPS 10
#define HOLO_BAR_WIDTH @BAR_WIDTH@   // bar length, as a fraction of the edge
#define HOLO_BAR_SOFT 0.01           // edge softening, so the bar doesn't alias
#define HOLO_SWEEP_DIST @SWEEP_DIST@ // how far along the edge the bar travels: 1 = to the right corner
#define HOLO_SWEEP_OPACITY @SWEEP_OPACITY@ // the bar's white opacity
#define HOLO_EDGE_TOP @EDGE_TOP@     // 1: run along the top edge, 0: along the bottom

#ifndef ALLOW_INCLUDES
#define ALLOW_INCLUDES
#extension GL_ARB_shading_language_include : enable
#endif
#ifndef GRADIENT_GLSL
#define GRADIENT_GLSL

vec4 okLabAToSrgb(vec4 lab) {
    float l = pow(lab[0] + lab[1] * 0.3963377774 + lab[2] * 0.2158037573, 3.0);
    float m = pow(lab[0] + lab[1] * (-0.1055613458) + lab[2] * (-0.0638541728), 3.0);
    float s = pow(lab[0] + lab[1] * (-0.0894841775) + lab[2] * (-1.2914855480), 3.0);

    return vec4(fromLinearRGB(vec3(l * 4.0767416621 + m * -3.3077115913 + s * 0.2309699292, l * (-1.2684380046) + m * 2.6097574011 + s * (-0.3413193965),
                                   l * (-0.0041960863) + m * (-0.7034186147) + s * 1.7076147010),
                              CM_TRANSFER_FUNCTION_GAMMA22),
                lab[3]);
}

float holoBar(float along, float center) {
    return 1.0 - smoothstep(HOLO_BAR_WIDTH * 0.5, HOLO_BAR_WIDTH * 0.5 + HOLO_BAR_SOFT, abs(along - center));
}

// holo: a control stop (see the top) is the 10th stop, black (OkLab L = 0).
bool holoHasControl(vec4 gradient[10], int gradientLength) {
    return gradientLength == 10 && gradient[9][0] < 0.001;
}

// holo: the colors as a loop repeated HOLO_REPEAT times.
vec4 holoColor(vec4 gradient[10], int gradientLength, float along) {
    int   n   = holoHasControl(gradient, gradientLength) ? 9 : gradientLength;
    float p   = fract(along * float(HOLO_REPEAT)) * float(n);
    int   lo  = int(floor(p));
    int   hi  = lo + 1 >= n ? 0 : lo + 1;
    float f   = p - float(lo);
    return gradient[hi] * f + gradient[lo] * (1.0 - f);
}

// holo: where a border pixel sits on the sweep's edge, 0 at the left corner to 1 at the right;
// -1 on the other three sides. uv has y = 0 at the top.
float holoPath(vec2 uv) {
    float d  = HOLO_EDGE_TOP == 1 ? uv.y : 1.0 - uv.y;   // distance from the sweep's edge
    float dl = uv.x, dr = 1.0 - uv.x, dfar = 1.0 - d;
    return d <= dl && d <= dr && d < dfar ? uv.x : -1.0;
}

// holo: the sweep bar drawn over the border color c (OkLab).
vec4 holoSweep(vec4 c, vec2 uv, vec4 gradient[10], int gradientLength) {
    if (!holoHasControl(gradient, gradientLength) || gradient[9][3] < 0.5 / 255.0)
        return c;
    float sweep = (gradient[9][3] * 255.0 - 1.0) / 254.0;
    float pos   = holoPath(uv);
    if (pos < 0.0)
        return c;
    float head = mix(-0.5 * HOLO_BAR_WIDTH, HOLO_SWEEP_DIST, sweep);
    float k    = HOLO_SWEEP_OPACITY * (1.0 - smoothstep(0.7, 1.0, sweep)) * holoBar(pos, head);   // fades out over the last 30%
    return mix(c, vec4(1.0, 0.0, 0.0, c[3]), k);   // toward white (OkLab), keeping the border's opacity
}

vec4 getOkColorForCoordArray1(vec2 normalizedCoord, int gradientLength, vec4 gradient[10], float angle) {
    if (gradientLength <= 0)
        return vec4(0.0);
    if (gradientLength < 2)
        return gradient[0];

    float finalAng = 0.0;

    if (angle > 4.71 /* 270 deg */) {
        normalizedCoord[1] = 1.0 - normalizedCoord[1];
        finalAng           = 6.28 - angle;
    } else if (angle > 3.14 /* 180 deg */) {
        normalizedCoord[0] = 1.0 - normalizedCoord[0];
        normalizedCoord[1] = 1.0 - normalizedCoord[1];
        finalAng           = angle - 3.14;
    } else if (angle > 1.57 /* 90 deg */) {
        normalizedCoord[0] = 1.0 - normalizedCoord[0];
        finalAng           = 3.14 - angle;
    } else {
        finalAng = angle;
    }

    float sine     = sin(finalAng);
    float along    = normalizedCoord[1] * sine + normalizedCoord[0] * (1.0 - sine);

    if (gradientLength >= HOLO_MIN_STOPS)   // holo: loop the colors (last fades back into first), HOLO_REPEAT times
        return holoColor(gradient, gradientLength, along);

    float progress = along * float(gradientLength - 1);

    if (progress >= float(gradientLength - 1))
        return gradient[gradientLength - 1];

    int   bottom = int(floor(progress));
    int   top    = bottom + 1;

    return gradient[top] * (progress - float(bottom)) + gradient[bottom] * (float(top) - progress);
}

vec4 getOkColorForCoordArray2(vec2 normalizedCoord, int gradient2Length, vec4 gradient2[10], float angle2) {
    if (gradient2Length < 2)
        return gradient2[0];

    float finalAng = 0.0;

    if (angle2 > 4.71 /* 270 deg */) {
        normalizedCoord[1] = 1.0 - normalizedCoord[1];
        finalAng           = 6.28 - angle2;
    } else if (angle2 > 3.14 /* 180 deg */) {
        normalizedCoord[0] = 1.0 - normalizedCoord[0];
        normalizedCoord[1] = 1.0 - normalizedCoord[1];
        finalAng           = angle2 - 3.14;
    } else if (angle2 > 1.57 /* 90 deg */) {
        normalizedCoord[0] = 1.0 - normalizedCoord[0];
        finalAng           = 3.14 - angle2;
    } else {
        finalAng = angle2;
    }

    float sine     = sin(finalAng);
    float along    = normalizedCoord[1] * sine + normalizedCoord[0] * (1.0 - sine);

    if (gradient2Length >= HOLO_MIN_STOPS)   // holo: loop the colors (last fades back into first), HOLO_REPEAT times
        return holoColor(gradient2, gradient2Length, along);

    float progress = along * float(gradient2Length - 1);

    if (progress >= float(gradient2Length - 1))
        return gradient2[gradient2Length - 1];

    int   bottom = int(floor(progress));
    int   top    = bottom + 1;

    return gradient2[top] * (progress - float(bottom)) + gradient2[bottom] * (float(top) - progress);
}

vec4 getColorForCoord(vec2 normalizedCoord, int gradientLength, vec4 gradient[10], float angle, int gradient2Length, vec4 gradient2[10], float angle2, float gradientLerp) {
    vec4 result1 = getOkColorForCoordArray1(normalizedCoord, gradientLength, gradient, angle);

    if (gradient2Length <= 0)
        return okLabAToSrgb(holoSweep(result1, normalizedCoord, gradient, gradientLength));

    vec4 result2 = getOkColorForCoordArray2(normalizedCoord, gradient2Length, gradient2, angle2);

    return okLabAToSrgb(holoSweep(mix(result1, result2, gradientLerp), normalizedCoord, gradient, gradientLength));
}
#endif
