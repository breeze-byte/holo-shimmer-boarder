// holo-border override of Hyprland v0.56.2's src/render/shaders/glsl/gradient.glsl.
// GENERATED by gen-holo-border.py from lib/shaders/gradient.glsl.in; loaded with
// "hyprctl reloadshaders <dir>". Identical to the original, except a gradient with at least
// HOLO_MIN_STOPS colors (the holo border) is treated as a loop and repeated HOLO_REPEAT times,
// so it gets more, shorter bands than Hyprland's 10-color limit allows. Every other gradient
// (inactive border, other plugins) renders exactly as before.
//
// Switch sweep: when the 10th stop is a control stop (black, i.e. OkLab L = 0) only the first 9
// are colors, and the control stop's alpha byte says what to draw: 0 = no sweep, otherwise
// 1 + mode * 63 + step, where step 0..62 is the position from start to end, mode's bit 0 runs the
// sweep along the left and right sides (else the top and bottom) and bit 1 runs it backward (right
// to left, or down; else left to right, or up). The sweep is a white bar on each of the two edges,
// moving together, fading in to HOLO_SWEEP_OPACITY and back out to 0 as they go.
#define HOLO_REPEAT @REPEAT@
#define HOLO_MIN_STOPS 10
#define HOLO_BAR_WIDTH @BAR_WIDTH@   // total length of the bar's lines and gaps, as a fraction of the edge
#define HOLO_BAR_LINES @BAR_LINES@   // the bar is this many parallel lines
#define HOLO_BAR_GAP @BAR_GAP@       // gap between lines, as a fraction of one line's width
#define HOLO_GLOW @GLOW@             // 1: a soft glow that brightens the bands' own colors; 0: hard bars mixed toward white
#define HOLO_GLOW_TINT @GLOW_TINT@   // glow: how much of the band's color stays at the brightest point (1 = all, 0 = pure white)
#define HOLO_BAR_RIM @BAR_RIM@       // how much darker (OkLab lightness) a thin rim on each side of the bar is
#define HOLO_BAR_RIM_WIDTH @BAR_RIM_WIDTH@ // the rim's width, as a fraction of one line's width
#define HOLO_BAR_GREY @BAR_GREY@     // OkLab lightness of all but the leading line (1 = white like the leading one)
#define HOLO_BAR_SOFT 0.004          // edge softening, so the lines don't alias
#define HOLO_SWEEP_DIST @SWEEP_DIST@ // how far along the edge the bars travel: 1 = to the far corner
#define HOLO_SWEEP_BOUNCE @SWEEP_BOUNCE@ // after reaching the far end the bar drifts back this far (fraction of the edge), fading out
#define HOLO_SWEEP_SPLIT @SWEEP_SPLIT@   // fraction of a pass spent going out (the rest is the drift back)
#define HOLO_SWEEP_FADE_IN @SWEEP_FADE_IN@ // fraction of the run spent fading in, before fading back out
#define HOLO_SWEEP_OPACITY @SWEEP_OPACITY@ // the bar's white opacity

#ifndef ALLOW_INCLUDES
#define ALLOW_INCLUDES
#extension GL_ARB_shading_language_include : enable
#endif
#ifndef GRADIENT_GLSL
#define GRADIENT_GLSL

vec4 okLabAToSrgb(vec4 lab) {
    float l = pow(lab[0] + lab[1] * 0.3963377774 + lab[2] * 0.2158037573, 3.0);
    float m = pow(lab[0] + lab[1] * (-0.1055613458) + lab[2] * (-0.0638541728), 3.0);
    float s = pow(lab[0] + lab[1] * (-0.0894841775) + lab[2] * (-1.2914855480), 3.0);

    return vec4(fromLinearRGB(vec3(l * 4.0767416621 + m * -3.3077115913 + s * 0.2309699292, l * (-1.2684380046) + m * 2.6097574011 + s * (-0.3413193965),
                                   l * (-0.0041960863) + m * (-0.7034186147) + s * 1.7076147010),
                              CM_TRANSFER_FUNCTION_GAMMA22),
                lab[3]);
}

// holo: the bar centered at center: HOLO_BAR_LINES lines with gaps between them, HOLO_BAR_WIDTH long in
// all. Returns (coverage, lightness): the leading line (furthest along) is white, the others HOLO_BAR_GREY.
vec2 holoBar(float along, float center) {
    float n = float(HOLO_BAR_LINES);
    float w = HOLO_BAR_WIDTH / (n + (n - 1.0) * HOLO_BAR_GAP);   // one line's width
    vec2  r = vec2(0.0, 1.0);
    for (int k = 0; k < HOLO_BAR_LINES; k++) {
        float c = center - 0.5 * HOLO_BAR_WIDTH + w * (0.5 + float(k) * (1.0 + HOLO_BAR_GAP));
        float m = 1.0 - smoothstep(w * 0.5, w * 0.5 + HOLO_BAR_SOFT, abs(along - c));
        if (m > r[0])
            r = vec2(m, k == HOLO_BAR_LINES - 1 ? 1.0 : HOLO_BAR_GREY);
    }
    return r;
}

// holo: a control stop (see the top) is the 10th stop, black (OkLab L = 0).
bool holoHasControl(vec4 gradient[10], int gradientLength) {
    return gradientLength == 10 && gradient[9][0] < 0.001;
}

// holo: the colors as a loop repeated HOLO_REPEAT times.
vec4 holoColor(vec4 gradient[10], int gradientLength, float along) {
    int   n   = holoHasControl(gradient, gradientLength) ? 9 : gradientLength;
    float p   = fract(along * float(HOLO_REPEAT)) * float(n);
    int   lo  = int(floor(p));
    int   hi  = lo + 1 >= n ? 0 : lo + 1;
    float f   = p - float(lo);
    return gradient[hi] * f + gradient[lo] * (1.0 - f);
}

// holo: where a border pixel sits on the sweep's edges: for the top and bottom, 0 at the left
// corner to 1 at the right; for the sides (sides), 0 at the bottom to 1 at the top; -1 on the
// other two edges. uv has y = 0 at the top.
float holoPath(vec2 uv, bool sides) {
    float dx = min(uv.x, 1.0 - uv.x), dy = min(uv.y, 1.0 - uv.y);   // distance to the sides / to the top or bottom
    if (sides)
        return dx < dy ? 1.0 - uv.y : -1.0;
    return dy <= dx ? uv.x : -1.0;
}

// holo: the sweep bar drawn over the border color c (OkLab).
vec4 holoSweep(vec4 c, vec2 uv, vec4 gradient[10], int gradientLength) {
    if (!holoHasControl(gradient, gradientLength) || gradient[9][3] < 0.5 / 255.0)
        return c;
    int   v     = int(floor(gradient[9][3] * 255.0 + 0.5)) - 1;
    int   mode  = v / 63;
    float sweep = float(v - mode * 63) / 62.0;
    float pos   = holoPath(uv, mode == 1 || mode == 3);
    if (pos < 0.0)
        return c;
    if (mode >= 2)   // backward: right to left, or down
        pos = 1.0 - pos;
    float head, env;
    if (HOLO_SWEEP_BOUNCE > 0.0) {
        // out to the far end at a steady pace, slowing to a stop over the last 30% of the way and
        // easing in to full opacity over the first HOLO_SWEEP_FADE_IN; then it eases back
        // HOLO_SWEEP_BOUNCE (speeding up and slowing down again) while smoothly fading to 0
        float o = sweep / HOLO_SWEEP_SPLIT;
        if (o < 1.0) {
            const float o0 = 0.7;                        // where the slowdown starts
            float v = 1.0 / (o0 + 0.5 * (1.0 - o0));     // the steady speed, so it ends exactly at 1
            float d = max(0.0, o - o0);
            head = mix(-0.5 * HOLO_BAR_WIDTH, HOLO_SWEEP_DIST, v * (o - d * d / (2.0 * (1.0 - o0))));
            env  = smoothstep(0.0, HOLO_SWEEP_FADE_IN, o);
        } else {
            float b = smoothstep(0.0, 1.0, (sweep - HOLO_SWEEP_SPLIT) / (1.0 - HOLO_SWEEP_SPLIT));
            head = HOLO_SWEEP_DIST - HOLO_SWEEP_BOUNCE * b;
            env  = 1.0 - b;
        }
    } else {
        // eases in to full opacity over the first HOLO_SWEEP_FADE_IN of the run, then fades evenly to 0
        head = mix(-0.5 * HOLO_BAR_WIDTH, HOLO_SWEEP_DIST, sweep);
        env  = smoothstep(0.0, HOLO_SWEEP_FADE_IN, sweep) * clamp((1.0 - sweep) / (1.0 - HOLO_SWEEP_FADE_IN), 0.0, 1.0);
    }
    if (HOLO_GLOW == 1) {
        // Light, not a shape: a bell curve of brightness (it fades to nothing about HOLO_BAR_WIDTH / 2
        // either side of its center) that lifts the band's own color toward white and keeps most of
        // its hue, like a highlight passing over foil.
        float d = (pos - head) / (0.25 * HOLO_BAR_WIDTH);
        float g = HOLO_SWEEP_OPACITY * env * exp(-d * d);
        c[0] += g * (1.0 - c[0]);                         // OkLab lightness toward 1
        c[1] *= 1.0 - g * (1.0 - HOLO_GLOW_TINT);         // chroma eases off a little, so it reads as light
        c[2] *= 1.0 - g * (1.0 - HOLO_GLOW_TINT);
        return c;
    }
    vec2  bar  = holoBar(pos, head);
    float k    = HOLO_SWEEP_OPACITY * env * bar[0];
    // A thin darker rim just outside the bar on each side, so white still pops on pale bands.
    float n    = float(HOLO_BAR_LINES);
    float rw   = HOLO_BAR_RIM_WIDTH * HOLO_BAR_WIDTH / (n + (n - 1.0) * HOLO_BAR_GAP);
    float out_ = abs(pos - head) - 0.5 * HOLO_BAR_WIDTH;   // distance outside the bar's span
    float rim  = out_ > 0.0 ? 1.0 - smoothstep(0.0, rw, out_) : 0.0;
    c[0]      -= HOLO_BAR_RIM * env * rim;
    return mix(c, vec4(bar[1], 0.0, 0.0, c[3]), k);   // toward white or grey (OkLab), keeping the border's opacity
}

vec4 getOkColorForCoordArray1(vec2 normalizedCoord, int gradientLength, vec4 gradient[10], float angle) {
    if (gradientLength <= 0)
        return vec4(0.0);
    if (gradientLength < 2)
        return gradient[0];

    float finalAng = 0.0;

    if (angle > 4.71 /* 270 deg */) {
        normalizedCoord[1] = 1.0 - normalizedCoord[1];
        finalAng           = 6.28 - angle;
    } else if (angle > 3.14 /* 180 deg */) {
        normalizedCoord[0] = 1.0 - normalizedCoord[0];
        normalizedCoord[1] = 1.0 - normalizedCoord[1];
        finalAng           = angle - 3.14;
    } else if (angle > 1.57 /* 90 deg */) {
        normalizedCoord[0] = 1.0 - normalizedCoord[0];
        finalAng           = 3.14 - angle;
    } else {
        finalAng = angle;
    }

    float sine     = sin(finalAng);
    float along    = normalizedCoord[1] * sine + normalizedCoord[0] * (1.0 - sine);

    if (gradientLength >= HOLO_MIN_STOPS)   // holo: loop the colors (last fades back into first), HOLO_REPEAT times
        return holoColor(gradient, gradientLength, along);

    float progress = along * float(gradientLength - 1);

    if (progress >= float(gradientLength - 1))
        return gradient[gradientLength - 1];

    int   bottom = int(floor(progress));
    int   top    = bottom + 1;

    return gradient[top] * (progress - float(bottom)) + gradient[bottom] * (float(top) - progress);
}

vec4 getOkColorForCoordArray2(vec2 normalizedCoord, int gradient2Length, vec4 gradient2[10], float angle2) {
    if (gradient2Length < 2)
        return gradient2[0];

    float finalAng = 0.0;

    if (angle2 > 4.71 /* 270 deg */) {
        normalizedCoord[1] = 1.0 - normalizedCoord[1];
        finalAng           = 6.28 - angle2;
    } else if (angle2 > 3.14 /* 180 deg */) {
        normalizedCoord[0] = 1.0 - normalizedCoord[0];
        normalizedCoord[1] = 1.0 - normalizedCoord[1];
        finalAng           = angle2 - 3.14;
    } else if (angle2 > 1.57 /* 90 deg */) {
        normalizedCoord[0] = 1.0 - normalizedCoord[0];
        finalAng           = 3.14 - angle2;
    } else {
        finalAng = angle2;
    }

    float sine     = sin(finalAng);
    float along    = normalizedCoord[1] * sine + normalizedCoord[0] * (1.0 - sine);

    if (gradient2Length >= HOLO_MIN_STOPS)   // holo: loop the colors (last fades back into first), HOLO_REPEAT times
        return holoColor(gradient2, gradient2Length, along);

    float progress = along * float(gradient2Length - 1);

    if (progress >= float(gradient2Length - 1))
        return gradient2[gradient2Length - 1];

    int   bottom = int(floor(progress));
    int   top    = bottom + 1;

    return gradient2[top] * (progress - float(bottom)) + gradient2[bottom] * (float(top) - progress);
}

vec4 getColorForCoord(vec2 normalizedCoord, int gradientLength, vec4 gradient[10], float angle, int gradient2Length, vec4 gradient2[10], float angle2, float gradientLerp) {
    vec4 result1 = getOkColorForCoordArray1(normalizedCoord, gradientLength, gradient, angle);

    if (gradient2Length <= 0)
        return okLabAToSrgb(holoSweep(result1, normalizedCoord, gradient, gradientLength));

    vec4 result2 = getOkColorForCoordArray2(normalizedCoord, gradient2Length, gradient2, angle2);

    return okLabAToSrgb(holoSweep(mix(result1, result2, gradientLerp), normalizedCoord, gradient, gradientLength));
}
#endif
