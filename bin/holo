#!/bin/bash
# Toggle the holo window border (gradient shimmer + drift + mouse tilt + flash).
#   holo on | off | toggle | status | restart | refresh | start
#   holo palette [next | prev | list | <name>]   (next by default; Super+Alt+H)
# State lives in ~/.local/state/holo; code and config in ~/.config/hypr/holo.

DIR="$HOME/.config/hypr/holo"
STATE="$HOME/.local/state/holo"
FLAG="$STATE/enabled"
PIDFILE="$STATE/drift.pid"
OUT="$HOME/.config/hypr/holo-border.lua"

mkdir -p "$STATE"

enabled() { [[ -f $FLAG ]]; }
running() { [[ -f $PIDFILE ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }

start_daemon() {
  running && return
  setsid python3 "$DIR/drift.py" >/dev/null 2>&1 &
  echo $! >"$PIDFILE"
}

stop_daemon() {
  running && kill "$(cat "$PIDFILE")" 2>/dev/null
  rm -f "$PIDFILE"
}

# HOLO_NO_HYPRCTL=1 skips talking to Hyprland (used by the installer's tests).
reload() { [[ -n $HOLO_NO_HYPRCTL ]] || hyprctl reload >/dev/null 2>&1; }
# The border shader override (bands.repeat) is a patched copy of Hyprland 0.56's gradient.glsl,
# so it is only loaded on 0.56; elsewhere (or with holo off) Hyprland's own shaders are used.
SHADER_DIR="$STATE/shaders"
shaders() {
  [[ -n $HOLO_NO_HYPRCTL ]] && return
  if enabled && [[ -f $SHADER_DIR/gradient.glsl ]] && hyprctl version | grep -q '^Hyprland 0\.56\.'; then
    hyprctl reloadshaders "$SHADER_DIR" >/dev/null
  else
    hyprctl reloadshaders >/dev/null
  fi
}
# While on, holo sets each window's own active border; put them all back to the configured one.
reset_borders() { [[ -n $HOLO_NO_HYPRCTL ]] || python3 "$DIR/reset-borders.py"; }
notify() { [[ -n $HOLO_NO_HYPRCTL ]] || notify-send -u low "Holo border" "$1" 2>/dev/null; }

case "${1:-toggle}" in
  on)
    touch "$FLAG"
    python3 "$DIR/gen-holo-border.py" && reload && shaders
    [[ -n $HOLO_NO_HYPRCTL ]] || start_daemon
    notify "On"
    ;;
  off)
    rm -f "$FLAG"
    stop_daemon
    shaders
    # Off sets nothing, so Omarchy's own border (width, colors, animation) applies again.
    printf -- '-- holo border is off (run: holo on); Omarchy'"'"'s own border settings apply\n' >"$OUT"
    reload
    reset_borders
    notify "Off"
    ;;
  toggle)
    if enabled; then "$0" off; else "$0" on; fi
    ;;
  status)
    if enabled; then echo "on (daemon: $(running && echo running || echo stopped))"; else echo off; fi
    ;;
  restart)   # after editing config.toml
    if enabled; then
      stop_daemon
      python3 "$DIR/gen-holo-border.py" && reload && shaders
      start_daemon
    fi
    ;;
  refresh)   # after a theme change: regenerate the colors if enabled; if off, follow the new theme's border
    if enabled; then
      python3 "$DIR/gen-holo-border.py" && reload && shaders
    else
      reset_borders
    fi
    ;;
  palette)   # switch the colors; the daemon picks up the new colors.json by itself
    if [[ ${2:-next} == list ]]; then python3 "$DIR/palette.py" list; exit; fi
    label=$(python3 "$DIR/palette.py" "${2:-next}") || exit 1
    if enabled; then
      before=$(cat "$SHADER_DIR/gradient.glsl" 2>/dev/null | md5sum)
      python3 "$DIR/gen-holo-border.py"
      # dark chrome's black sweep is baked into the shader: reload it only when it changed
      [[ $(cat "$SHADER_DIR/gradient.glsl" 2>/dev/null | md5sum) == "$before" ]] || shaders
      notify "Colors: $label"
    else
      notify "Colors: $label (holo is off)"
    fi
    echo "$label"
    ;;
  start)     # at login: make sure the daemon runs if enabled
    enabled && { shaders; start_daemon; }
    ;;
  *)
    echo "usage: holo on|off|toggle|status|restart|refresh|start|palette [next|prev|list|<name>]" >&2
    exit 1
    ;;
esac
